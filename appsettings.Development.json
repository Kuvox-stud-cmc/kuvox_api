{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=kuvox;Username=kuvox;Password=kuvox",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "dev-only-super-secret-signing-key-change-me-please-32+chars",
    "Issuer": "kuvox-api",
    "Audience": "kuvox-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "kuvox",
    "Password": "kuvox",
    "VirtualHost": "/",
    "ExchangeName": "kuvox.events"
  },
  "Messaging": {
    "RetryDelaysSeconds": [30, 120, 600],
    "ConsumerPrefetch": 4,
    "OutboxPollIntervalSeconds": 5,
    "OutboxBatchSize": 50
  },
  "MediaPipelineRecovery": {
    "Enabled": true,
    "StaleAfterMinutes": 15,
    "PollIntervalSeconds": 60,
    "BatchSize": 100
  },
  "Storage": {
    "Endpoint": "http://localhost:8333",
    "Region": "us-east-1",
    "RawBucketName": "kuvox-raw",
    "RenderBucketName": "kuvox-renders",
    "CreateBucket": false
  },
  "AiService": {
    "GrpcUrl": "http://localhost:50051"
  },
  "Email": {
    "FromEmail": "no-reply@kuvox.app",
    "FromName": "Kuvox"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "DevSeed": {
    "Email": "dev@kuvox.local",
    "Password": "Password123!",
    "DisplayName": "Dev User"
  }
}
