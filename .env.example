# ---------------------------------------------------------------------------
# Kuvox API environment configuration
#
# Copy this file to `api/.env` for local native development. The API loads this
# file through DotNetEnv before ASP.NET configuration binding.
#
# Hostname rules by runtime:
# - Native Linux: use localhost because Docker publishes infra ports to the host.
# - Native macOS: use the same localhost values as Linux.
# - Native Windows: use the same localhost values as Linux/macOS.
# - API running in Docker Compose: use Compose service names instead:
#   ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=kuvox;Username=kuvox;Password=kuvox
#   ConnectionStrings__Redis=redis:6379
#   RabbitMQ__HostName=rabbitmq
#   Storage__Endpoint=http://seaweedfs-s3:8333
# - Do not mix per-repo Compose files with the workspace-root Compose file;
#   run exactly one infra set at a time.
# ---------------------------------------------------------------------------

# Environment (Development | Production). Production runs without the localhost
# defaults baked into appsettings.Development.json.
ASPNETCORE_ENVIRONMENT=Development

# Cors — default origins live in appsettings.json. To override via env vars use
# indexed keys (the code binds Cors:AllowedOrigins as a string[]):
# Cors__AllowedOrigins__0=https://kuvox.linkednodedigital.com
# Cors__AllowedOrigins__1=http://localhost:5173

# Connection strings for the application.
# Native Linux: localhost works with published Docker ports.
# Native macOS: same as Linux.
# Native Windows: same as Linux/macOS.
# Docker Compose API container: use Host=postgres and Redis host redis.
# NOTE: keys must match the code: GetConnectionString("Postgres") / ("Redis").
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=kuvox;Username=kuvox;Password=kuvox
ConnectionStrings__Redis=localhost:6379

# JWT settings
Jwt__Secret=your_jwt_secret_key
Jwt__Issuer=kuvox_api
Jwt__Audience=kuvox_clients
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# RabbitMQ settings.
# Native Linux: RabbitMQ__HostName=localhost.
# Native macOS: same as Linux.
# Native Windows: same as Linux/macOS.
# Docker Compose API container: RabbitMQ__HostName=rabbitmq.
RabbitMQ__HostName=localhost
RabbitMQ__Port=5672
RabbitMQ__UserName=kuvox
RabbitMQ__Password=kuvox
RabbitMQ__VirtualHost=/
RabbitMQ__ExchangeName=kuvox.events
Messaging__RetryDelaysSeconds__0=30
Messaging__RetryDelaysSeconds__1=120
Messaging__RetryDelaysSeconds__2=600
Messaging__ConsumerPrefetch=4
Messaging__OutboxPollIntervalSeconds=5
Messaging__OutboxBatchSize=50
MediaPipelineRecovery__Enabled=true
MediaPipelineRecovery__StaleAfterMinutes=15
MediaPipelineRecovery__PollIntervalSeconds=60
MediaPipelineRecovery__BatchSize=100

# Storage settings.
# Native Linux: Storage__Endpoint=http://localhost:8333.
# Native macOS: same as Linux.
# Native Windows: same as Linux/macOS.
# Docker Compose API container: Storage__Endpoint=http://seaweedfs-s3:8333.
Storage__Endpoint=http://localhost:8333
Storage__Region=us-east-1
Storage__AccessKey=kuvox-api-dev
Storage__SecretKey=replace-with-local-api-secret
Storage__RawBucketName=kuvox-raw
Storage__CreateBucket=false

# AI Services settings.
# Native local AI service: localhost if/when the gRPC endpoint is enabled.
# Docker Compose API container: use the AI service container name if one is added.
AiService__GrpcUrl=http://localhost:50051

# Email settings (empty ApiKey = dev log mode; set via env in real envs)
Email__ApiKey=
Email__FromEmail=no-reply@kuvox.app
Email__FromName=Kuvox

# Frontend base URL (used for building email verification / password reset links)
Frontend__BaseUrl=http://localhost:5173
