{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Metrics": {
    "Enabled": true
  },
  "Caching": {
    "Enabled": false,
    "HttpValidatorsEnabled": false,
    "KeyPrefix": "kuvox:v1",
    "TtlJitterPercent": 10,
    "ConnectTimeoutMilliseconds": 500,
    "OperationTimeoutMilliseconds": 500,
    "MaxPayloadBytes": 1048576,
    "StampedeProtectionEnabled": false,
    "StudioUsageSingleFlightEnabled": false,
    "LockTtlMilliseconds": 5000,
    "LockWaitMilliseconds": 2000,
    "LockPollMilliseconds": 50,
    "StudioSettingsPrewarmEnabled": false,
    "TaskReferencePrewarmEnabled": false,
    "PrewarmQueueCapacity": 256,
    "PrewarmStartupDelayMilliseconds": 5000,
    "PrewarmStartupStudioIds": [],
    "GenerationTtlSeconds": 2592000,
    "BusinessReads": { "Enabled": false },
    "UserSettings": { "Enabled": false, "TtlSeconds": 120 },
    "Studio": { "Enabled": false, "SettingsTtlSeconds": 120, "ReferencesTtlSeconds": 600 },
    "Projects": { "Enabled": false, "DetailTtlSeconds": 60, "ListTtlSeconds": 30, "MediaTtlSeconds": 20 },
    "Media": { "Enabled": false, "TtlSeconds": 20 },
    "Albums": { "Enabled": false, "TtlSeconds": 20 },
    "StorageUsage": { "Enabled": false, "TtlSeconds": 15 },
    "Tasks": { "Enabled": false, "TtlSeconds": 15, "ReferencesTtlSeconds": 300 },
    "Notifications": { "Enabled": false, "TtlSeconds": 10 },
    "NotificationCount": { "Enabled": false, "TtlSeconds": 10 },
    "EditorDocuments": { "Enabled": false, "TtlSeconds": 15 },
    "RenderJobs": { "Enabled": false, "TtlSeconds": 3 }
  },
  "Messaging": {
    "RetryDelaysSeconds": [30, 120, 600],
    "ConsumerPrefetch": 4,
    "OutboxPollIntervalSeconds": 5,
    "OutboxBatchSize": 50
  },
  "MediaPipelineRecovery": {
    "Enabled": true,
    "StaleAfterMinutes": 15,
    "PollIntervalSeconds": 60,
    "BatchSize": 100
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://kuvox.linkednodedigital.com"
    ]
  },
  "Email": {
    "FromEmail": "no-reply@kuvox.app",
    "FromName": "Kuvox"
  },
  "Frontend": {
    "BaseUrl": "https://kuvox.linkednodedigital.com"
  }
}
