{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "RetryDelaysSeconds": [30, 120, 600],
    "ConsumerPrefetch": 4,
    "OutboxPollIntervalSeconds": 5,
    "OutboxBatchSize": 50
  },
  "MediaPipelineRecovery": {
    "Enabled": true,
    "StaleAfterMinutes": 15,
    "PollIntervalSeconds": 60,
    "BatchSize": 100
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://kuvox.linkednodedigital.com"
    ]
  },
  "Email": {
    "ApiKey": "",
    "FromEmail": "no-reply@kuvox.app",
    "FromName": "Kuvox"
  },
  "Frontend": {
    "BaseUrl": "https://kuvox.linkednodedigital.com"
  }
}
